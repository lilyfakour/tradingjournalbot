# Copy this file to .env and paste your real token.
# Get a token from @BotFather on Telegram: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=1234567890:AAAA-your-token-here

# Optional — where data lives. Point all three at a persistent volume when
# hosting (e.g. Railway: attach a Volume mounted at /data and use):
#JOURNAL_DB=/data/journal.db
#SCREENSHOT_DIR=/data/screenshots
#EXPORT_DIR=/data/exports
